<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="250"
        x:Class="EchoText.Views.UpdateCheckDialog"
        Title="Check for Updates"
        Width="400" Height="250"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        Icon="/Assets/Icons/tray-idle.ico">

    <Border Padding="30">
        <StackPanel Spacing="20">

            <!-- Icon and Title -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                <TextBlock x:Name="StatusIcon"
                           FontSize="32"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="TitleText"
                           FontSize="20"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Message -->
            <TextBlock x:Name="MessageText"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       FontSize="14"
                       Foreground="{DynamicResource SystemControlForegroundBaseMediumHighBrush}"/>

            <!-- Version Info (shown when update available) -->
            <StackPanel x:Name="VersionInfoPanel"
                        IsVisible="False"
                        HorizontalAlignment="Center"
                        Spacing="4">
                <TextBlock x:Name="CurrentVersionText"
                           FontSize="13"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                <TextBlock x:Name="LatestVersionText"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Spacing="12"
                        Margin="0,10,0,0">
                <Button x:Name="DownloadButton"
                        Content="Download Update"
                        IsVisible="False"
                        Width="150"
                        Padding="16,8"
                        Classes="accent"
                        Click="OnDownloadClick"/>
                <Button Content="Close"
                        Width="100"
                        Padding="12,8"
                        Click="OnCloseClick"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
